generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations; on Neon/Supabase use the pooled URL above for the app.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Auth (Better Auth) ───────────────────────────────

enum Role {
  CUSTOMER
  SUPER_ADMIN
  STORE_MANAGER
  FINANCE_MANAGER
  CONTENT_EDITOR
  SUPPORT_AGENT
  FULFILLMENT
}

enum AccountStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  CLOSED
}

enum Currency {
  HTG
  USD
}

model User {
  id               String        @id
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  image            String?
  phone            String?
  role             Role          @default(CUSTOMER)
  status           AccountStatus @default(ACTIVE)
  locale           String        @default("ht")
  displayCurrency  Currency      @default(HTG)
  twoFactorEnabled Boolean?      @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  orders         Order[]
  ledgerAccounts LedgerAccount[]
  paymentIntents PaymentIntent[]  @relation("PaymentCustomer")
  reviewed       PaymentIntent[]  @relation("PaymentReviewer")
  quotes         ExchangeQuote[]
  notifications  Notification[]
  savedPlayerIds SavedPlayerId[]
  riskFlags      RiskFlag[]
  auditEvents    AuditEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─────────────────────────────── Catalog ───────────────────────────────

/// Localized text is stored as JSON: { "ht": "...", "fr": "...", "en": "...", "es": "..." }
model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        Json
  description Json?
  icon        String?
  sortOrder   Int        @default(0)
  isVisible   Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum FulfillmentType {
  CODE_INVENTORY
  MANUAL
  SUPPLIER_API
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  name             Json
  description      Json
  deliveryEstimate Json?
  image            String?
  accent           String?
  isPublished      Boolean          @default(false)
  isFeatured       Boolean          @default(false)
  fulfillmentType  FulfillmentType  @default(MANUAL)
  /// Array of custom field definitions: [{ key, label: {ht,fr,en,es}, type, required, placeholder? }]
  fields           Json             @default("[]")
  seoTitle         Json?
  seoDescription   Json?
  sortOrder        Int              @default(0)
  variants         ProductVariant[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId, isPublished])
}

model ProductVariant {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         Json
  /// Price in HTG centimes (integer minor units)
  priceHtg     Int
  salePriceHtg Int?
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  sku          String?     @unique
  codes        CodeItem[]
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum CodeStatus {
  AVAILABLE
  ASSIGNED
  VOID
}

model CodeItem {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  codeEncrypted String
  /// HMAC of the code; prevents importing the same code twice
  codeHash      String         @unique
  batchLabel    String?
  costHtg       Int?
  status        CodeStatus     @default(AVAILABLE)
  orderItemId   String?
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id])
  createdAt     DateTime       @default(now())
  assignedAt    DateTime?

  @@index([variantId, status])
  @@index([orderItemId])
}

model SavedPlayerId {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  label     String?
  values    Json
  createdAt DateTime @default(now())

  @@index([userId, productId])
}

// ─────────────────────────────── Orders ───────────────────────────────

enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  PAID
  PROCESSING
  FULFILLED
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentMethodKind {
  WALLET
  MONCASH
  NATCASH
}

model Order {
  id            String            @id @default(cuid())
  number        Int               @unique @default(autoincrement())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  status        OrderStatus       @default(AWAITING_PAYMENT)
  currency      Currency
  /// Totals in minor units of `currency`
  subtotal      Int
  total         Int
  /// HTG per 1 USD at the time of the order, when charged in USD
  rateUsed      Decimal?          @db.Decimal(18, 8)
  paymentMethod PaymentMethodKind
  recipientNote String?
  accessToken   String            @unique
  items         OrderItem[]
  events        OrderEvent[]
  payments      PaymentIntent[]
  riskFlags     RiskFlag[]
  paidAt        DateTime?
  fulfilledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

enum ItemStatus {
  PENDING
  DELIVERED
  FAILED
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  productName  Json
  variantName  Json
  quantity     Int
  unitPrice    Int
  fieldValues  Json           @default("{}")
  status       ItemStatus     @default(PENDING)
  deliveryNote String?
  codes        CodeItem[]
}

/// Append-only order history
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

// ─────────────────────────────── Payments ───────────────────────────────

enum PaymentProvider {
  MONCASH
  NATCASH
}

enum PaymentStatus {
  PENDING
  REVIEW
  SUCCEEDED
  FAILED
  REJECTED
  EXPIRED
}

/// External money coming in. Every successful intent credits the customer's wallet;
/// when linked to an order, the order is then paid from the wallet in the same transaction.
model PaymentIntent {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("PaymentCustomer", fields: [userId], references: [id])
  orderId      String?
  order        Order?          @relation(fields: [orderId], references: [id])
  provider     PaymentProvider
  amount       Int
  currency     Currency        @default(HTG)
  status       PaymentStatus   @default(PENDING)
  /// Provider transaction id (MonCash) or customer-submitted reference (NatCash); unique per provider
  providerRef  String?
  payerPhone   String?
  evidencePath String?
  reviewedById String?
  reviewedBy   User?           @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  holdUntil    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  riskFlags    RiskFlag[]

  @@unique([provider, providerRef])
  @@index([status, provider])
  @@index([userId, createdAt])
}

// ─────────────────────────────── Ledger ───────────────────────────────

enum LedgerAccountType {
  CUSTOMER_WALLET
  CUSTOMER_HELD
  CLEARING
  REVENUE
  FX
  ADJUSTMENT
}

model LedgerAccount {
  id            String            @id @default(cuid())
  code          String            @unique
  type          LedgerAccountType
  currency      Currency
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  /// Cached balance in minor units; kept in sync inside every posting transaction
  balance       Int               @default(0)
  allowNegative Boolean           @default(false)
  entries       LedgerEntry[]
  createdAt     DateTime          @default(now())

  @@index([userId])
}

enum LedgerTxType {
  DEPOSIT
  PURCHASE
  REFUND
  EXCHANGE
  ADJUSTMENT
  HOLD_RELEASE
}

model LedgerTransaction {
  id             String        @id @default(cuid())
  type           LedgerTxType
  idempotencyKey String        @unique
  description    String
  createdById    String?
  metadata       Json          @default("{}")
  entries        LedgerEntry[]
  createdAt      DateTime      @default(now())
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  currency      Currency
  /// Signed amount in minor units. Entries of one transaction sum to zero per currency.
  amount        Int
  createdAt     DateTime          @default(now())

  @@index([accountId, createdAt])
  @@index([transactionId])
}

model ExchangeQuote {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  fromCurrency Currency
  toCurrency   Currency
  fromAmount   Int
  toAmount     Int
  rate         Decimal   @db.Decimal(18, 8)
  feeAmount    Int
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

// ─────────────────────────────── Risk, audit, settings, notifications ───────────────────────────────

enum RiskStatus {
  OPEN
  APPROVED
  REJECTED
}

model RiskFlag {
  id              String         @id @default(cuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id])
  reason          String
  status          RiskStatus     @default(OPEN)
  resolvedById    String?
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?

  @@index([status])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Message key in the `notifications` namespace, rendered in the reader's language
  type      String
  params    Json      @default("{}")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
