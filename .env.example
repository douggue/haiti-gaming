# Database. On Vercel use a pooled connection string for DATABASE_URL (Neon "-pooler" host or Supabase port 6543
# with ?pgbouncer=true) and the direct connection for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/haiti_gaming"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/haiti_gaming"

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Encryption key for gift-card codes and provider secrets (32 bytes, base64)
ENCRYPTION_KEY=""

# Public site URL (used for SEO, payment return URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# MonCash (leave empty to run MonCash in mock mode for development)
MONCASH_MODE="sandbox"          # sandbox | live
MONCASH_CLIENT_ID=""
MONCASH_CLIENT_SECRET=""

# Private file storage for NatCash payment screenshots: a Vercel Blob store with private access.
# Connecting the Blob store to the Vercel project sets this automatically. Without it, screenshots are
# skipped in production (the reference number still works).
BLOB_READ_WRITE_TOKEN=""

# Cron secret for /api/cron/* (reconciliation, MonCash status polling)
CRON_SECRET=""
